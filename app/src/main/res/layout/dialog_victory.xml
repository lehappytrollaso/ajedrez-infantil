<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:gravity="center"
    android:padding="24dp">

    <!-- Trophy Icon with glow -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_trophy"
        android:contentDescription="Trofeo de campeona" />

    <TextView
        android:id="@+id/tvVictoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="¡¡¡Victoria Mágica!!! 🎉"
        android:textColor="@color/primary_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvVictoryMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="¡Has jugado fenomenal y le diste Jaque Mate a Sparky! 👑✨"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:gravity="center" />

    <!-- Stars -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_star_gold"
            android:contentDescription="Estrella" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="8dp"
            android:src="@drawable/ic_star_gold"
            android:contentDescription="Estrella" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_star_gold"
            android:contentDescription="Estrella" />
    </LinearLayout>

    <!-- Buttons -->
    <Button
        android:id="@+id/btnVictoryPlayAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_button_primary"
        android:text="¡Jugar otra partida! 🎮"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

    <Button
        android:id="@+id/btnVictoryMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_accent"
        android:text="Volver al Menú 🏠"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

</LinearLayout>
