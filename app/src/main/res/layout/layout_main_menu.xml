<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <!-- Top Bar with Sound Toggle and Stars Counter -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Stars Counter Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_rounded"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_star_gold"
                android:contentDescription="Estrellas" />

            <TextView
                android:id="@+id/tvTotalStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0 / 21"
                android:textColor="@color/text_dark"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Theme Button -->
        <ImageView
            android:id="@+id/btnThemeToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_theme_palette"
            android:padding="11dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Temas" />

        <!-- Sound Button -->
        <ImageView
            android:id="@+id/btnSoundToggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_sound_on"
            android:padding="11dp"
            android:contentDescription="Sonido" />
    </LinearLayout>

    <!-- Header Mascot & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:src="@drawable/ic_robot_sparky"
            android:contentDescription="Sparky" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajedrez Mágico"
            android:textColor="@color/primary_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Aprende a jugar divirtiéndote! ✨"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Main Navigation Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Card 1: Aprender a Jugar (Tutorial) -->
        <LinearLayout
            android:id="@+id/btnMenuTutorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Piece icon circle -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_button_circle">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/piece_knight_white"
                    android:contentDescription="Aprender" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aprende las Piezas"
                    android:textColor="@color/primary_dark"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tutorial con esquemas y retos ⭐"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="Ir" />
        </LinearLayout>

        <!-- Card 2: Minijuegos Mágicos -->
        <LinearLayout
            android:id="@+id/btnMenuMinigames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:elevation="4dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_button_circle">
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/piece_pawn_white"
                    android:contentDescription="Minijuegos" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minijuegos Mágicos"
                    android:textColor="@color/accent_mint"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guerra de Peones y el Caballito ⚔️"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="Ir" />
        </LinearLayout>

        <!-- Card 3: Partida Amistosa (Play vs AI) -->
        <LinearLayout
            android:id="@+id/btnMenuPlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:elevation="4dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Robot icon circle -->
            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_button_circle">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_robot_sparky"
                    android:contentDescription="Jugar" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partida Amistosa"
                    android:textColor="@color/accent_pink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Juega contra Sparky con ayudas 🤖"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_forward"
                android:contentDescription="Ir" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom encouragement -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diseñado con amor para pequeñas maestras de ajedrez 🌸"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginBottom="8dp" />

</LinearLayout>
